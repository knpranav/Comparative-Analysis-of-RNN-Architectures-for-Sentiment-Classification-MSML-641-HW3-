# Basic .gitignore

# OS files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
.env

# Java / Maven / Gradle
target/
*.class
*.jar
*.war
*.ear

# Build / distribution
build/
dist/
out/

# Logs
*.log
logs/

# Coverage
coverage/
.coverage
coverage.xml
htmlcov/

# IDEs and editors
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.iml

# Temp files
*.tmp
*.temp
*.swp
*.swo

# Secrets / keys
*.pem
*.key

# Optional: lock files you may or may not want to ignore
# package-lock.json
# yarn.lock